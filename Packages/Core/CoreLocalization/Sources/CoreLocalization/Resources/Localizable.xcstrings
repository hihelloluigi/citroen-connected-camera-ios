    "onboarding.camera_unreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach the camera. Check you're on its Wi‑Fi and try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere la telecamera. Verifica di essere connesso al suo Wi‑Fi e riprova."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con la cámara. Comprueba que estás en su Wi‑Fi e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre la caméra. Vérifiez que vous êtes sur son Wi‑Fi et réessayez."
          }
        }
      }
    },
