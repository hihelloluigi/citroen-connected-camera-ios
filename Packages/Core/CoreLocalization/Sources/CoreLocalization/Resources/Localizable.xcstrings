    "onboarding.connect_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings › Wi‑Fi, join the camera's network. A new camera's password is ConnectedCam; if you've already set your own, use that. Then come back here."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Impostazioni › Wi‑Fi, collegati alla rete della telecamera. La password di una telecamera nuova è ConnectedCam; se ne hai già impostata una tua, usa quella. Poi torna qui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes › Wi‑Fi, conéctate a la red de la cámara. La contraseña de una cámara nueva es ConnectedCam; si ya has definido la tuya, usa esa. Después vuelve aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages › Wi‑Fi, rejoignez le réseau de la caméra. Le mot de passe d'une caméra neuve est ConnectedCam ; si vous avez déjà défini le vôtre, utilisez-le. Revenez ensuite ici."
          }
        }
      }
    },
    "onboarding.connect_join_prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join the camera's network — it's named ConnectedCAM followed by four digits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collegati alla rete della telecamera: si chiama ConnectedCAM seguito da quattro cifre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Únete a la red de la cámara: se llama ConnectedCAM seguido de cuatro dígitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez le réseau de la caméra : il s'appelle ConnectedCAM suivi de quatre chiffres."
          }
        }
      }
    },
    "onboarding.connect_on_network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're on %@. Join the camera's network (ConnectedCAM…) if you haven't."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei connesso a %@. Collegati alla rete della telecamera (ConnectedCAM…) se non l'hai già fatto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás conectado a %@. Únete a la red de la cámara (ConnectedCAM…) si aún no lo has hecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes connecté à %@. Rejoignez le réseau de la caméra (ConnectedCAM…) si ce n'est pas déjà fait."
          }
        }
      }
    },
    "onboarding.connect_reset_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New camera? Hold both buttons for 2 seconds until it beeps to factory reset. This erases all recordings on the camera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Telecamera nuova? Tieni premuti entrambi i pulsanti per 2 secondi finché non emette un segnale acustico per ripristinarla. Questo cancella tutte le registrazioni sulla telecamera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cámara nueva? Mantén pulsados ambos botones 2 segundos hasta que suene un pitido para restablecerla. Esto borra todas las grabaciones de la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caméra neuve ? Maintenez les deux boutons enfoncés 2 secondes jusqu'au bip pour la réinitialiser. Cela efface tous les enregistrements de la caméra."
          }
        }
      }
    },
    "onboarding.connect_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the camera's Wi‑Fi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
