          }
        }
      }
    },
    "onboarding.location_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location lets the app show which Wi‑Fi network you're on, so it can confirm you're connected to the camera. You can skip this — the app still works without it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione permette all'app di mostrare a quale rete Wi‑Fi sei connesso, così può confermare il collegamento alla telecamera. Puoi saltare questo passaggio: l'app funziona comunque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación permite que la app muestre a qué red Wi‑Fi estás conectado, para confirmar la conexión con la cámara. Puedes omitirlo: la app funciona igualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation permet à l'app d'afficher le réseau Wi‑Fi auquel vous êtes connecté, afin de confirmer la liaison avec la caméra. Vous pouvez ignorer cette étape : l'app fonctionne quand même."
          }
        }
      }
    },
    "onboarding.location_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Location access"
          }
        },
