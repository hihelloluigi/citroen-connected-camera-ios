    "onboarding.reconnect_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera restarted its Wi‑Fi with the new password. In Settings › Wi‑Fi, rejoin the camera's network using the password you just set."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La telecamera ha riavviato il Wi‑Fi con la nuova password. In Impostazioni › Wi‑Fi, ricollegati alla rete della telecamera usando la password appena impostata."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara reinició su Wi‑Fi con la nueva contraseña. En Ajustes › Wi‑Fi, vuelve a conectarte a la red de la cámara con la contraseña que acabas de establecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra a redémarré son Wi‑Fi avec le nouveau mot de passe. Dans Réglages › Wi‑Fi, rejoignez à nouveau le réseau de la caméra avec le mot de passe que vous venez de définir."
          }
        }
      }
