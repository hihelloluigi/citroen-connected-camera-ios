    "onboarding.local_network_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app talks to your camera directly over its Wi‑Fi. iOS will ask for Local Network access the first time it connects — please allow it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app comunica con la telecamera direttamente tramite il suo Wi‑Fi. iOS chiederà l'accesso alla rete locale alla prima connessione: consentilo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se comunica con la cámara directamente a través de su Wi‑Fi. iOS pedirá acceso a la red local la primera vez que se conecte; permítelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app communique avec la caméra directement via son Wi‑Fi. iOS demandera l'accès au réseau local lors de la première connexion : autorisez-le."
          }
        }
      }
    },
    "onboarding.local_network_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Local Network access"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso alla rete locale"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acceso a la red local"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l'accès au réseau local"
          }
        }
      }
    },
    "onboarding.location_allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti accesso"
          }
        },
        "es": {
          "stringUnit": {
