          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se aceptó la contraseña actual. Introduce la contraseña actual de la cámara e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe actuel n'a pas été accepté. Saisissez le mot de passe actuel de la caméra et réessayez."
