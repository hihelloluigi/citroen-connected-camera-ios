    "camera_error.decoding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera sent an unexpected response."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La telecamera ha inviato una risposta imprevista."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara envió una respuesta inesperada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra a envoyé une réponse inattendue."
          }
        }
      }
    },
    "camera_error.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera refused the request."
          }
