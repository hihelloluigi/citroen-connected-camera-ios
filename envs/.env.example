# Copy to envs/.env.development (and .env.staging / .env.production) and fill in.
# envs/.env.* is git-ignored — only this example is tracked.
#
# Read by scripts/generate_secrets.sh, which rewrites each KEY=VALUE as an xcconfig
# assignment into Configurations/Secrets.xcconfig.

# Apple Developer Team ID. Only needed to sign for a physical device — simulator builds
# work with this blank, which is why App.xcconfig's include is optional.
CCAM_TEAM_ID=
