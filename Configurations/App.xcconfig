//
//  App.xcconfig — build settings shared by every environment.
//
//  Layering: each environment xcconfig does `#include "../App.xcconfig"` then
//  `#include? "../Secrets.xcconfig"` (generated by scripts/generate_secrets.sh, git-ignored).
//  xcconfig is last-definition-wins, so a generated secret overrides everything here, and the
//  `?` means a fresh clone with no envs/.env.* still generates and opens — it just can't sign
//  for a device until Secrets.xcconfig exists.
//

IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 6.0

// App-owned build settings are CCAM_-prefixed so they're never confused with an Xcode-native
// setting of a similar shape. CCAM_TEAM_ID arrives from envs/.env.<environment>.
DEVELOPMENT_TEAM = $(CCAM_TEAM_ID)

// The camera's fixed AP gateway. Not a secret — it is the same literal on every unit — but it
// lives here as a build setting so a bench rig or a future mock server can be pointed
// somewhere else without touching code. `/$()/` escapes `//`, which xcconfig would otherwise
// read as the start of a comment; Xcode resolves `$()` to an empty string at build time.
CCAM_CAMERA_BASE_URL = http:/$()/192.168.0.1
