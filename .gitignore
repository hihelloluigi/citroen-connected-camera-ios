# ==============================================================================
# Citroën Connected Camera iOS — .gitignore
# Swift · SwiftUI · Xcode · SPM
# ==============================================================================

# ==============================================================================
# Secrets & environment — never commit
# ==============================================================================

.env
.env.*
!.env.example
envs/.env
envs/.env.*
!envs/.env.example

# Generated xcconfig, written by scripts/generate_secrets.sh at build time
Configurations/Secrets.xcconfig

# ==============================================================================
# Xcode
# ==============================================================================

# Generated by XcodeGen — project.yml is the source of truth
*.xcodeproj
*.xcworkspace

# User-specific workspace state — never shared
*.xcuserstate
xcuserdata/
*.xccheckout
*.moved-aside

# Build intermediates
DerivedData/
build/

# Test result bundles
*.xcresult

# Legacy per-user preference files (keep defaults, ignore overrides)
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# Playground artifacts
timeline.xctimeline
playground.xcworkspace

# ==============================================================================
# Swift Package Manager
# ==============================================================================

.build/
.swiftpm/

# Per-package resolved files are ignored: the local packages are libraries only
# built standalone for tests, and their lockfiles duplicate — and drift from —
# the pin the generated project resolves. The only remote dependency is the
# SwiftLint plugin, pinned exactly in every Package.swift.
Packages/**/Package.resolved

# Stray SPM workspace artifacts created when swift/xcodebuild runs inside a
# package dir. Depth-2 because packages live under a tier directory
# (Packages/Core/CoreX/, Packages/Features/FeatureX/).
Packages/*/*/artifacts/
Packages/*/*/checkouts/
Packages/*/*/repositories/
Packages/*/*/workspace-state.json

# ==============================================================================
# CocoaPods (if ever added)
# ==============================================================================

Pods/

# ==============================================================================
# Logs & CI
# ==============================================================================

*.log

# Release credentials must never land in the tree.
*.p8
*-service-account*.json

# ==============================================================================
# IDE & editors
# ==============================================================================

.vscode/
.idea/
*.iml

# ==============================================================================
# macOS
# ==============================================================================

.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ==============================================================================
# AI tools
# ==============================================================================

# Claude
.claude/

# Codex
.codex/

# Superpowers (local brainstorming — never shared)
.superpowers/
docs/superpowers/
